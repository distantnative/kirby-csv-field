{
	"name": "distantnative/kirby-csv-field",
	"description": "Kirby CMS Panel field to upload and display a single CSV file",
	"license": "MIT",
	"type": "kirby-plugin",
	"keywords": [
		"kirby-plugin",
		"csv",
		"spreadsheet",
		"field"
	],
	"version": "2.0.0",
	"homepage": "https://distantnative.com/kirby-csv-field/",
	"authors": [
		{
			"name": "Nico Hoffmann",
			"email": "nico@getkirby.com"
		}
	],
	"require": {
		"php": "~8.3.0 || ~8.4.0 || ~8.5.0",
		"getkirby/cms": "^6.0",
		"getkirby/composer-installer": "^1.2"
	},
	"require-dev": {
		"getkirby/cms": "dev-v6/develop as 6.0.0-beta.1"
	},
	"autoload-dev": {
		"psr-4": {
			"distantnative\\CsvField\\": "tests/"
		}
	},
	"extra": {
		"installer-name": "csv-field",
		"kirby": {
			"compatible": "^6.0"
		},
		"kirby-cms-path": false
	},
	"scripts": {
		"fix": "cpx getkirby/php-cs:^0.2 fix",
		"test": "cpx brianium/paratest:7.20.0"
	},
	"minimum-stability": "beta",
	"prefer-stable": true,
	"config": {
		"allow-plugins": {
			"getkirby/composer-installer": true
		}
	}
}
